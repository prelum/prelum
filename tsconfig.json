{
  // Type-checks everything (src + tests) and emits nothing. The build uses tsconfig.build.json.
  "compilerOptions": {
    // Modern JS that Node >= 22 runs natively, as ESM.
    "target": "es2023",
    "module": "nodenext",
    "types": ["node"],
    "noEmit": true,

    // Strictness.
    "strict": true,
    "noUncheckedIndexedAccess": true,

    // Keep every file runnable by `node file.ts` (type stripping) and by tsc alike:
    // imports use the real `.ts` extension, tsc rewrites them to `.js` on build.
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,

    "skipLibCheck": true
  },
  "include": ["src", "tests", "scripts"]
}
