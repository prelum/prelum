{
  "name": "prelum",
  "version": "0.0.1",
  "description": "Markdown in. Beautiful PDF out.",
  "keywords": [
    "markdown",
    "pdf",
    "cli",
    "themes",
    "mermaid",
    "offline"
  ],
  "homepage": "https://prelum.github.io",
  "bugs": "https://github.com/prelum/prelum/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prelum/prelum.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "prelum": "dist/cli.js"
  },
  "files": [
    "dist",
    "themes",
    "vendor"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "biome check",
    "fix": "biome check --write",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "playwright-core": "1.65.1",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  }
}
